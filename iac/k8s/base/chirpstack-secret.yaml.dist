apiVersion: v1
kind: Secret
metadata:
  name: lorawan-secrets
  namespace: lorawan
type: Opaque
stringData:
  POSTGRES_USER: "chirpstack"
  POSTGRES_PASSWORD: "CHANGE_ME_SECURE_PASSWORD"
  CHIRPSTACK_SECRET_KEY: "CHANGE_ME_32_BYTE_SECRET_KEY"
  POSTGRES_DSN: "postgresql://chirpstack:CHANGE_ME_SECURE_PASSWORD@postgres.lorawan.svc.cluster.local:5432/chirpstack?sslmode=disable"
